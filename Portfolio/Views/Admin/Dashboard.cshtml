@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="container-fluid px-3">

    <!-- Page Header -->
    <div class="mb-4">
        <h3 class="fw-semibold mb-1">Dashboard</h3>
        <p class="text-muted mb-0">
            Welcome to your portfolio admin panel.
        </p>
    </div>

    <!-- Dashboard Cards -->
    <div class="row g-3">

        <!-- Projects -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-1">Projects</p>
                            <h3 class="fw-bold mb-0">
                                @(ViewBag.ProjectCount ?? 0)
                            </h3>
                        </div>

                        <div class="fs-2 text-primary">
                            <i class="bi bi-folder"></i>
                        </div>
                    </div>

                    <a href="@Url.Action("ShowProjects", "Admin")"
                       class="text-decoration-none small mt-3 d-inline-block">
                        View Projects <i class="bi bi-arrow-right"></i>
                    </a>

                </div>
            </div>
        </div>

        <!-- Skills -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-1">Skills</p>
                            <h3 class="fw-bold mb-0">
                                @(ViewBag.SkillCount ?? 0)
                            </h3>
                        </div>

                        <div class="fs-2 text-warning">
                            <i class="bi bi-lightning"></i>
                        </div>
                    </div>

                    <a href="@Url.Action("ShowSkill", "Admin")"
                       class="text-decoration-none small mt-3 d-inline-block">
                        View Skills <i class="bi bi-arrow-right"></i>
                    </a>

                </div>
            </div>
        </div>

        <!-- Experience -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-1">Experience</p>
                            <h3 class="fw-bold mb-0">
                                @(ViewBag.ExperienceCount ?? 0)
                            </h3>
                        </div>

                        <div class="fs-2 text-success">
                            <i class="bi bi-briefcase"></i>
                        </div>
                    </div>

                    <a href="@Url.Action("ShowExperience", "Admin")"
                       class="text-decoration-none small mt-3 d-inline-block">
                        View Experience <i class="bi bi-arrow-right"></i>
                    </a>

                </div>
            </div>
        </div>

        <!-- Messages -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-1">Messages</p>
                            <h3 class="fw-bold mb-0">
                                @(ViewBag.MessageCount ?? 0)
                            </h3>
                        </div>

                        <div class="fs-2 text-danger">
                            <i class="bi bi-envelope"></i>
                        </div>
                    </div>

                    <a href="@Url.Action("ShowContact", "Admin")"
                       class="text-decoration-none small mt-3 d-inline-block">
                        View Messages <i class="bi bi-arrow-right"></i>
                    </a>

                </div>
            </div>
        </div>

    </div>


    <!-- Second Row -->
    <div class="row g-3 mt-1">

        <!-- Education -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Education</p>
                            <h3 class="fw-bold mb-0">
                                @(ViewBag.EducationCount ?? 0)
                            </h3>
                        </div>

                        <i class="bi bi-mortarboard fs-2 text-info"></i>
                    </div>

                    <a href="@Url.Action("ShowEducation", "Admin")"
                       class="text-decoration-none small mt-3 d-inline-block">
                        View Education <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Services -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Services</p>
                            <h3 class="fw-bold mb-0">
                                @(ViewBag.ServiceCount ?? 0)
                            </h3>
                        </div>

                        <i class="bi bi-grid fs-2 text-secondary"></i>
                    </div>

                    <a href="@Url.Action("ShowService", "Admin")"
                       class="text-decoration-none small mt-3 d-inline-block">
                        View Services <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- About -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">About</p>
                            <h3 class="fw-bold mb-0">
                                @(ViewBag.AboutCount ?? 0)
                            </h3>
                        </div>

                        <i class="bi bi-person fs-2 text-primary"></i>
                    </div>

                    <a href="@Url.Action("About", "Admin")"
                       class="text-decoration-none small mt-3 d-inline-block">
                        Manage About <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Unread Messages -->
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Unread Messages</p>
                            <h3 class="fw-bold mb-0">
                                @(ViewBag.UnreadMessageCount ?? 0)
                            </h3>
                        </div>

                        <i class="bi bi-envelope-exclamation fs-2 text-danger"></i>
                    </div>

                    <a href="@Url.Action("ShowContact", "Admin")"
                       class="text-decoration-none small mt-3 d-inline-block">
                        Check Messages <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

    </div>


    <!-- Welcome / Quick Actions -->
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body">

            <h5 class="fw-semibold mb-3">
                Quick Actions
            </h5>

            <div class="d-flex flex-wrap gap-2">

                <a href="@Url.Action("Projects", "Admin")"
                   class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    Add Project
                </a>

                <a href="@Url.Action("ManageExperience", "Admin")"
                   class="btn btn-success">
                    <i class="bi bi-plus-lg"></i>
                    Add Experience
                </a>

                <a href="@Url.Action("ManageSkill", "Admin")"
                   class="btn btn-warning">
                    <i class="bi bi-plus-lg"></i>
                    Add Skill
                </a>

                <a href="@Url.Action("ManageEducation", "Admin")"
                   class="btn btn-info">
                    <i class="bi bi-plus-lg"></i>
                    Add Education
                </a>

            </div>

        </div>
    </div>

</div>