@model IEnumerable<Portfolio.Models.educationMaster>
@{
    ViewBag.Title = "ShowEducation";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="container-fluid px-3">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">Education</h4>
            <p class="text-muted mb-0">
                Manage your education and qualifications.
            </p>
        </div>
        <a href="@Url.Action("educationMaster", "Admin")" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add Education
        </a>
    </div>
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
            <i class="bi bi-check-circle me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" onclick="document.getElementById('successAlert').remove();" aria-label="Close"></button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
            <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" onclick="document.getElementById('errorAlert').remove();" aria-label="Close"></button>
        </div>
    }
    <!-- Education Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Degree</th>
                            <th>Institution</th>
                            <th>Location</th>
                            <th>Duration</th>
                            <th>Display Order</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int count = 1;

                            foreach (var item in Model.OrderBy(x => x.DisplayOrder))
                            {
                                <tr>
                                    <!-- Serial Number -->
                                    <td> @count </td>
                                    <!-- Degree -->
                                    <td> <strong>@item.Degree</strong></td>
                                    <!-- Institution -->
                                    <td> @item.InstitutionName</td>
                                    <!-- Location -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Location))
                                        {
                                            <span>
                                                <i class="bi bi-geo-alt me-1"></i>
                                                @item.Location
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <!-- Duration -->
                                    <td>
                                        <div>
                                            @if (!string.IsNullOrEmpty(item.StartDate))
                                            {
                                                @DateTime.Parse(item.StartDate).ToString("MMM yyyy")
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }

                                            <span class="mx-1">-</span>

                                            @if (!string.IsNullOrEmpty(item.EndDate))
                                            {
                                                @DateTime.Parse(item.EndDate).ToString("MMM yyyy")
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </div>
                                    </td>
                                    <!-- Display Order -->
                                    <td>
                                        @item.DisplayOrder
                                    </td>

                                    <!-- Status -->
                                    <td>

                                        @if (item.Status == "1")
                                        {
                                            <button type="button" class="btn btn-sm p-0 border-0" onclick="toggleEducationStatus('@item.id', 'Active')" title="Click to change status">
                                                <span class="badge bg-success">
                                                    Active
                                                </span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm p-0 border-0" onclick="toggleEducationStatus('@item.id', 'Inactive')" title="Click to change status">
                                                <span class="badge bg-warning text-dark">
                                                    Inactive
                                                </span>
                                            </button>
                                        }

                                    </td>

                                    <!-- Actions -->
                                    <td class="text-center">
                                        <!-- Edit -->
                                        <a href="@Url.Action("educationMaster", "Admin", new { id = item.id })" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <!-- Delete -->
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Delete" onclick="deleteEducation(@item.id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                                count++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-mortarboard fs-2 d-block mb-2"></i>
                                    No education records found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

    function deleteEducation(id) {

        Swal.fire({
            title: 'Delete Education?',
            text: 'Are you sure you want to delete this Education?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Delete',
            cancelButtonText: 'Cancel'
        }).then((result) => {

            if (result.isConfirmed) {

                window.location.href =
                    '@Url.Action("DeleteEducation", "Admin")' +
                    '?id=' + id;
            }
        });
    }
</script>
<script>

    function toggleEducationStatus(id, currentStatus) {

        var newStatus = currentStatus === "Active"
            ? "Inactive"
            : "Active";

        Swal.fire({
            title: 'Change Education Status?',
            text: 'This Education will be changed from ' + currentStatus + ' to ' + newStatus + '.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Yes, Change',
            cancelButtonText: 'Cancel'
        }).then(function (result) {

            if (result.isConfirmed) {

                var form = document.createElement("form");

                form.method = "POST";
                form.action = '@Url.Action("ToggleEducationStatus", "Admin")';

                var input = document.createElement("input");

                input.type = "hidden";
                input.name = "id";
                input.value = id;

                form.appendChild(input);

                document.body.appendChild(form);

                form.submit();
            }
        });
    }
</script>


