@model System.Data.DataTable
@{
    ViewBag.Title = "ShowProjects";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="container-fluid px-3">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a href="@Url.Action("Projects", "Admin")" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Add Project
        </a>
    </div>
   @if (TempData["Message"] != null) 
{ 
    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert"> 
        <i class="bi bi-check-circle me-2"></i> @TempData["Message"] 
        <button type="button" class="btn-close" onclick="document.getElementById('successAlert').remove();" aria-label="Close"></button> 
    </div> 
} 

<!-- Error Message --> 
@if (TempData["Error"] != null) 
{ 
    <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert"> 
        <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"] 
        <button type="button" class="btn-close" onclick="document.getElementById('errorAlert').remove();" aria-label="Close"></button> 
    </div> 
}

    <!-- Project List Card -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h6 class="mb-0">
                    <i class="bi bi-folder2-open me-2"></i>
                    Project List
                </h6>
                <span class="badge bg-light text-dark border">
                    @(Model == null ? 0 : Model.Rows.Count) Projects
                </span>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model != null && Model.Rows.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3" style="width:70px;"># </th>
                                <th style="width:100px;"> Image </th>
                                <th>Project</th>
                                <th>Technologies</th>
                                <th>Links</th>
                                <th>Status</th>
                                <th class="text-center" style="width:130px;">
                                    Action
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Rows.Count; i++)
                            {
                                var row = Model.Rows[i];
                                <tr>
                                    <!-- Serial No -->
                                    <td class="ps-3">
                                        @(i + 1)
                                    </td>

                                    <!-- Image -->
                                    <td>

                                        @if (row["ProjectImage"] != DBNull.Value &&
                                             !string.IsNullOrEmpty(row["ProjectImage"].ToString()))
                                        {
                                            <img src="@Url.Content(row["ProjectImage"].ToString())" alt="Project Image" class="rounded border" style="width:70px;height:50px;object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light border rounded d-flex align-items-center justify-content-center" style="width:70px;height:50px;">

                                                <i class="bi bi-image text-muted fs-5"></i>

                                            </div>
                                        }

                                    </td>


                                    <!-- Project Information -->
                                    <td>

                                        <div class="fw-semibold">
                                            @row["projectName"]
                                        </div>

                                        @if (row["shortDescription"] != DBNull.Value)
                                        {
                                            <small class="text-muted d-block" style="max-width:350px;">
                                                @row["shortDescription"]
                                            </small>
                                        }
                                    </td>
                                    <!-- Technologies -->
                                    <td>
                                        @if (row["technologies"] != DBNull.Value &&
                                             !string.IsNullOrEmpty(row["technologies"].ToString()))
                                        {
                                            foreach (var tech in row["technologies"].ToString().Split(','))
                                            {
                                                <span class="badge bg-light text-dark border me-1 mb-1">
                                                    @tech.Trim()
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>
                                    <!-- Links -->
                                    <td>

                                        @if (row["githubUrl"] != DBNull.Value &&
                                             !string.IsNullOrEmpty(row["githubUrl"].ToString()))
                                        {
                                            <a href="@row["githubUrl"]" target="_blank" class="btn btn-sm btn-outline-dark me-1" title="GitHub">
                                                <i class="bi bi-github"></i>
                                            </a>
                                        }

                                        @if (row["projectUrl"] != DBNull.Value &&
                                             !string.IsNullOrEmpty(row["projectUrl"].ToString()))
                                        {
                                            <a href="@row["projectUrl"]" target="_blank" class="btn btn-sm btn-outline-primary" title="Live Demo">
                                                <i class="bi bi-globe"></i>
                                            </a>
                                        }

                                        @if ((row["githubUrl"] == DBNull.Value ||
                                              string.IsNullOrEmpty(row["githubUrl"].ToString()))
                                             &&
                                             (row["projectUrl"] == DBNull.Value ||
                                              string.IsNullOrEmpty(row["projectUrl"].ToString())))
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>
                                    <!-- Status -->
                                    <td>

                                        @if (row["Status"] != DBNull.Value &&
                                             row["Status"].ToString() == "1")
                                        {
                                            <button type="button" class="btn btn-sm p-0 border-0" onclick="toggleProjectStatus('@row["id"]', 'Active')" title="Click to change status">
                                               <span class="badge bg-success">
                                                    Active
                                                </span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm p-0 border-0" onclick="toggleProjectStatus('@row["id"]', 'Inactive')" title="Click to change status">
                                                <span class="badge bg-warning">
                                                    Inactive
                                                </span>
                                            </button>
                                        }

                                    </td>
                                    <!-- Actions -->
                                    <td class="text-center">
                                        <div class="btn-group">
                                            <!-- Edit -->
                                            <a href="@Url.Action("Projects", "Admin", new { id = row["id"] })" class="btn btn-sm btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <!-- Delete -->
                                            <button type="button" class="btn btn-sm btn-outline-danger" title="Delete" onclick="deleteProjects('@row["id"]')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <!-- No Projects -->
                <div class="text-center py-5">

                    <i class="bi bi-folder-x fs-1 text-muted"></i>

                    <h6 class="mt-3 mb-1">
                        No Projects Found
                    </h6>

                    <p class="text-muted mb-3">
                        You have not added any portfolio projects yet.
                    </p>

                    <a href="@Url.Action("Projects", "Admin")" class="btn btn-primary">

                        <i class="bi bi-plus-lg me-1"></i>
                        Add Your First Project

                    </a>

                </div>
            }

        </div>
    </div>
</div>

<script src="https://jsdelivr.net"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

    function deleteProjects(id) {

        Swal.fire({
            title: 'Delete Project?',
            text: 'Are you sure you want to delete this project?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Delete',
            cancelButtonText: 'Cancel'
        }).then((result) => {

            if (result.isConfirmed) {

                window.location.href =
                    '@Url.Action("DeleteProjects", "Admin")' +
                    '?id=' + id;

            }

        });

    }

</script>
<script>

    function toggleProjectStatus(id, currentStatus) {

        var newStatus = currentStatus === "Active"
            ? "Inactive"
            : "Active";

        Swal.fire({
            title: 'Change Project Status?',
            text: 'This project will be changed from ' + currentStatus + ' to ' + newStatus + '.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Yes, Change',
            cancelButtonText: 'Cancel'
        }).then(function (result) {

            if (result.isConfirmed) {

                var form = document.createElement("form");

                form.method = "POST";
                form.action = '@Url.Action("ToggleProjectStatus", "Admin")';

                var input = document.createElement("input");

                input.type = "hidden";
                input.name = "id";
                input.value = id;

                form.appendChild(input);

                document.body.appendChild(form);

                form.submit();
            }

        });

    }

</script>

