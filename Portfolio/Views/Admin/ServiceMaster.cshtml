@model Portfolio.Models.serviceMaster
@{
    ViewBag.Title = Model.id == 0 ? "Add Service" : "Edit Service";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="container-fluid px-3">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                @(Model.id == 0 ? "Add Service" : "Edit Service")
            </h4>
            <p class="text-muted mb-0">
                @(Model.id == 0 ? "Add a new service to your portfolio." : "Update service details.")
            </p>
        </div>

        <a href="@Url.Action("ShowService", "Admin")" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    <!-- Messages -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i>
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            @TempData["Error"]

            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Service Form -->
    <div class="card shadow-sm border-0">
        <div class="card-body">
            @using (Html.BeginForm("ServiceMaster", "Admin", FormMethod.Post, new { @class = "needs-validation" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.id)
                <div class="row g-4">

                    <!-- Service Name -->
                    <div class="col-md-6">
                        <label class="form-label">
                            Service Name <span class="text-danger">*</span>
                        </label>

                        @Html.TextBoxFor( model => model.serviceName, new { @class = "form-control", placeholder = "Enter service name" })
                        @Html.ValidationMessageFor(model => model.serviceName, "", new { @class = "text-danger" })
                    </div>

                    <!-- Icon -->
                    <div class="col-md-6">
                        <label class="form-label">
                            Bootstrap Icon
                        </label>

                        @Html.TextBoxFor( model => model.icon, new { @class = "form-control", placeholder = "Example: bi bi-code-slash" })

                        <small class="text-muted">
                            Example:
                            <code>bi bi-code-slash</code>
                        </small>
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <label class="form-label">
                            Description <span class="text-danger">*</span>
                        </label>

                        @Html.TextAreaFor( model => model.description, new { @class = "form-control", rows = "5", placeholder = "Enter service description" })
                        @Html.ValidationMessageFor( model => model.description, "", new { @class = "text-danger" })
                    </div>

                    <!-- Status -->
                    <div class="col-md-6">
                        <label class="form-label">
                            Status
                        </label>

                        @Html.DropDownListFor( model => model.status, new List<SelectListItem>
                            {
                                new SelectListItem
                                {
                                    Text = "Active",
                                    Value = "1"
                                },
                                new SelectListItem
                                {
                                    Text = "Inactive",
                                    Value = "0"
                                }
                            },
                            "-- Select Status --",
                            new { @class = "form-select" })
                    </div>

                    <!-- Buttons -->
                    <div class="col-12">
                        <hr />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg"></i>
                                @(Model.id == 0 ? "Save Service" : "Update Service")
                            </button>
                            <a href="@Url.Action("ShowService", "Admin")" class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>
                    </div>

                </div>
            }
        </div>
    </div>
</div>