@model Portfolio.Models.educationMaster
@{
    ViewBag.Title = Model.id == 0 ? "Add Education" : "Edit Education";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="container-fluid px-3">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                @(Model.id == 0 ? "Add Education" : "Edit Education")
            </h4>

            <p class="text-muted mb-0">
                @(Model.id == 0 ? "Add a new education qualification to your portfolio." : "Update education details.")
            </p>
        </div>
        <a href="@Url.Action("ShowEducation", "Admin")" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
    <!-- Education Form -->
    <div class="card shadow-sm border-0">
        <div class="card-body">
            @using (Html.BeginForm("educationMaster", "Admin", FormMethod.Post, new { @class = "row g-3", id = "educationForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.id)
                <!-- Degree -->
                <div class="col-md-6">
                    <label class="form-label">
                        Degree / Qualification
                        <span class="text-danger">*</span>
                    </label>
                    @Html.TextBoxFor(model => model.Degree, new { @class = "form-control", placeholder = "e.g. B.Sc. Science", autocomplete = "off" })
                    @Html.ValidationMessageFor(model => model.Degree, "", new { @class = "text-danger" })
                </div>
                <!-- Institution -->
                <div class="col-md-6">
                    <label class="form-label">
                        Institution Name
                        <span class="text-danger">*</span>
                    </label>
                    @Html.TextBoxFor(model => model.InstitutionName, new { @class = "form-control", placeholder = "e.g. XYZ College", autocomplete = "off" })
                    @Html.ValidationMessageFor(model => model.InstitutionName, "", new { @class = "text-danger" })
                </div>

                <!-- Location -->
                <div class="col-md-6">
                    <label class="form-label">
                        Location
                    </label>
                    @Html.TextBoxFor(model => model.Location, new { @class = "form-control", placeholder = "e.g. Kanpur, Uttar Pradesh", autocomplete = "off" })
                    @Html.ValidationMessageFor(  model => model.Location,  "", new { @class = "text-danger" })
                </div>
                <!-- Start Date -->
                <div class="col-md-3">
                    <label class="form-label">
                        Start Date
                    </label>
                    @Html.TextBoxFor(model => model.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(model => model.StartDate, "", new { @class = "text-danger" })
                </div>
                <!-- End Date -->
                <div class="col-md-3">
                    <label class="form-label">
                        End Date
                    </label>
                    @Html.TextBoxFor(model => model.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(model => model.EndDate, "", new { @class = "text-danger" })
                </div>
                <!-- Description -->
                <div class="col-12">
                    <label class="form-label">
                        Description
                    </label>
                    @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = "4", placeholder = "Write a short description about your education..." })
                    @Html.ValidationMessageFor( model => model.Description, "", new { @class = "text-danger" })

                </div>
                <!-- Display Order -->
                <div class="col-md-6">
                    <label class="form-label">
                        Display Order
                    </label>
                    @Html.TextBoxFor(model => model.DisplayOrder, new { @class = "form-control", type = "number", min = "1", placeholder = "e.g. 1" })
                    @Html.ValidationMessageFor( model => model.DisplayOrder, "", new { @class = "text-danger" })
                </div>
                <!-- Status -->
                <div class="col-md-6">
                    <label class="form-label">
                        Status
                        <span class="text-danger">*</span>
                    </label>

                    @Html.DropDownListFor(model => model.Status,
                        new List<SelectListItem>
                        {
                            new SelectListItem
                            {
                                Text = "Active",
                                Value = "1"
                            },

                            new SelectListItem
                            {
                                Text = "Inactive",
                                Value = "0"
                            }
                        },
                        new { @class = "form-select" })
                    @Html.ValidationMessageFor( model => model.Status, "", new { @class = "text-danger" })
                </div>
                <!-- Buttons -->
                <div class="col-12 mt-4">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">

                            <i class="bi bi-check-lg"></i>

                            @(Model.id == 0 ? "Save Education" : "Update Education")

                        </button>

                        <a href="@Url.Action("ShowEducation", "Admin")" class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

