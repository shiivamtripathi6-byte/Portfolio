@model IEnumerable<Portfolio.Models.socialLinkMaster>
@{
    ViewBag.Title = "Social Links";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="container-fluid px-3">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Social Links</h3>
            <p class="text-muted mb-0">
                Manage your portfolio social media links.
            </p>
        </div>

        <a href="@Url.Action("SocialLink", "Admin")" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Add Social Link
        </a>
    </div>
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
            <i class="bi bi-check-circle me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" onclick="document.getElementById('successAlert').remove();" aria-label="Close"></button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
            <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" onclick="document.getElementById('errorAlert').remove();" aria-label="Close"></button>
        </div>
    }
    <!-- Social Links Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Platform</th>
                            <th>Icon</th>
                            <th>Profile URL</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int srNo = 1;

                            foreach (var item in Model)
                            {
                                <tr>

                                    <!-- Sr No -->
                                    <td>
                                        @srNo
                                    </td>

                                    <!-- Platform -->
                                    <td>
                                        <strong>
                                            @item.platformName
                                        </strong>
                                    </td>

                                    <!-- Icon -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.icon))
                                        {
                                            <i class="@item.icon fs-5"></i>
                                            <span class="ms-2 text-muted">
                                                @item.icon
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No Icon
                                            </span>
                                        }
                                    </td>

                                    <!-- URL -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.url))
                                        {
                                            <a href="@item.url" target="_blank" rel="noopener noreferrer">
                                                @item.url
                                                <i class="bi bi-box-arrow-up-right ms-1"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No URL
                                            </span>
                                        }
                                    </td>
                                    <!-- Status -->
                                    <td>

                                        @if (item.status == "1")
                                        {
                                            <button type="button" class="btn btn-sm p-0 border-0" onclick="toggleLinkStatus('@item.id', 'Active')" title="Click to change status">
                                                <span class="badge bg-success">
                                                    Active
                                                </span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm p-0 border-0" onclick="toggleLinkStatus('@item.id', 'Inactive')" title="Click to change status">
                                                <span class="badge bg-warning text-dark">
                                                    Inactive
                                                </span>
                                            </button>
                                        }

                                    </td>

                                    <!-- Actions -->
                                    <td class="text-center">
                                        <!-- Edit -->
                                        <a href="@Url.Action("SocialLink", "Admin", new { id = item.id })" class="btn btn-sm btn-outline-primary me-1" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <!----Delete---->
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Delete" onclick="deleteLink(@item.id)">
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </td>
                                </tr>
                                srNo++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">
                                    <div class="text-muted">
                                        <i class="bi bi-share fs-3 d-block mb-2"></i>
                                        No social links found.
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

    // Delete Social Links
    function deleteLink(id) {

        Swal.fire({
            title: 'Delete Social Links.?',
            text: 'Are you sure you want to delete this Links?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Delete',
            cancelButtonText: 'Cancel'
        }).then(function (result) {

            if (result.isConfirmed) {

                window.location.href =
                    '@Url.Action("DeleteLink", "Admin")' +
                    '?id=' + id;

            }

        });
    }
    // Toggle Social Link Status
    function toggleLinkStatus(id, currentStatus) {

        var newStatus = currentStatus === "Active"
            ? "Inactive"
            : "Active";

        Swal.fire({
            title: 'Change Status?',
            text: 'Are you sure you want to change status from ' +
                  currentStatus + ' to ' + newStatus + '?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Yes, Change',
            cancelButtonText: 'Cancel'
        }).then(function (result) {

            if (result.isConfirmed) {

                var form = document.createElement("form");

                form.method = "POST";
                form.action = '@Url.Action("ToggleLinkStatus", "Admin")';

                var input = document.createElement("input");

                input.type = "hidden";
                input.name = "id";
                input.value = id;

                form.appendChild(input);

                document.body.appendChild(form);

                form.submit();
            }

        });
    }

</script>

