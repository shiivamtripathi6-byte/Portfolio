@model IEnumerable<Portfolio.Models.skillMaster>
@{
    ViewBag.Title = "ShowSKills";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="container-fluid px-3">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">Skills</h4>
            <p class="text-muted mb-0">
                Manage your portfolio skills.
            </p>
        </div>

        <a href="@Url.Action("ManageSkills", "Admin")" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add Skill
        </a>
    </div>
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
            <i class="bi bi-check-circle me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" onclick="document.getElementById('successAlert').remove();" aria-label="Close"></button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
            <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" onclick="document.getElementById('errorAlert').remove();" aria-label="Close"></button>
        </div>
    }
    <!-- Skills Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Skill Name</th>
                            <th>Category</th>
                            <th>Skill Level</th>
                            <th>Display Order</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int count = 1;

                            foreach (var item in Model.OrderBy(x => x.DisplayOrder))
                            {
                                <tr>

                                    <!-- Sr No -->
                                    <td>
                                        @count
                                    </td>

                                    <!-- Skill Name -->
                                    <td>
                                        <strong>
                                            @item.SkillName
                                        </strong>
                                    </td>

                                    <!-- Category -->
                                    <td>
                                        @item.Category
                                    </td>

                                    <!-- Skill Level -->
                                    <td>
                                        @if (item.SkillLevel == "Beginner")
                                        {
                                            <span class="badge bg-secondary">
                                                Beginner
                                            </span>
                                        }
                                        else if (item.SkillLevel == "Intermediate")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Intermediate
                                            </span>
                                        }
                                        else if (item.SkillLevel == "Advanced")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Advanced
                                            </span>
                                        }
                                        else if (item.SkillLevel == "Expert")
                                        {
                                            <span class="badge bg-success">
                                                Expert
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <!-- Display Order -->
                                    <td>
                                        @item.DisplayOrder
                                    </td>

                                    <!-- Status -->
                                    <td>

                                        @if (item.Status == "1")
                                        {
                                            <button type="button" class="btn btn-sm p-0 border-0" onclick="toggleSkillStatus('@item.id', 'Active')" title="Click to change status">
                                                <span class="badge bg-success">
                                                    Active
                                                </span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm p-0 border-0" onclick="toggleSkillStatus('@item.id', 'Inactive')" title="Click to change status">
                                                <span class="badge bg-warning text-dark">
                                                    Inactive
                                                </span>
                                            </button>
                                        }

                                    </td>
                                    <!-- Action -->
                                    <td class="text-center">
                                        <!-- Edit -->
                                        <a href="@Url.Action("ManageSkills", "Admin", new { id = item.id })" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <!-- Delete -->
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Delete" onclick="deleteSkills(@item.id)">

                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">

                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>

                                    No skills found.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

    function deleteSkills(id) {

        Swal.fire({
            title: 'Delete Skills?',
            text: 'Are you sure you want to delete this Skills?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Delete',
            cancelButtonText: 'Cancel'
        }).then((result) => {

            if (result.isConfirmed) {

                window.location.href =
                    '@Url.Action("DeleteSkills", "Admin")' +
                    '?id=' + id;

            }

        });

    }

</script>
<script>

    function toggleSkillStatus(id, currentStatus) {

        var newStatus = currentStatus === "Active"
            ? "Inactive"
            : "Active";

        Swal.fire({
            title: 'Change Skills Status?',
            text: 'This Skills will be changed from ' + currentStatus + ' to ' + newStatus + '.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Yes, Change',
            cancelButtonText: 'Cancel'
        }).then(function (result) {

            if (result.isConfirmed) {

                var form = document.createElement("form");

                form.method = "POST";
                form.action = '@Url.Action("ToggleSkillStatus", "Admin")';

                var input = document.createElement("input");

                input.type = "hidden";
                input.name = "id";
                input.value = id;

                form.appendChild(input);

                document.body.appendChild(form);

                form.submit();
            }

        });

    }

</script>


