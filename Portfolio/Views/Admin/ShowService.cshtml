@model IEnumerable<Portfolio.Models.serviceMaster>
@{
    ViewBag.Title = "ShowService";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="container-fluid px-3">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">Services</h4>
            <p class="text-muted mb-0">
                Manage your portfolio services.
            </p>
        </div>

        <a href="@Url.Action("ServiceMaster", "Admin")" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add Service
        </a>
    </div>
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
            <i class="bi bi-check-circle me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" onclick="document.getElementById('successAlert').remove();" aria-label="Close"></button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
            <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" onclick="document.getElementById('errorAlert').remove();" aria-label="Close"></button>
        </div>
    }
    <!-- Services Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th width="70">#</th>
                            <th>Service</th>
                            <th>Icon</th>
                            <th>Description</th>
                            <th width="120">Status</th>
                            <th width="160">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int sr = 1;

                            foreach (var item in Model)
                            {
                                <tr>

                                    <!-- Sr No -->
                                    <td>
                                        @sr
                                    </td>

                                    <!-- Service Name -->
                                    <td>
                                        <strong>
                                            @item.serviceName
                                        </strong>
                                    </td>

                                    <!-- Icon -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.icon))
                                        {
                                            <i class="@item.icon fs-5"></i>
                                            <small class="text-muted ms-2">
                                                @item.icon
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No Icon
                                            </span>
                                        }
                                    </td>

                                    <!-- Description -->
                                    <td>
                                        @{
                                            string description = item.description ?? "";

                                            if (description.Length > 80)
                                            {
                                                description = description.Substring(0, 80) + "...";
                                            }
                                        }

                                        @description
                                    </td>
                                    <!-- Status -->
                                    <td>

                                        @if (item.status == "1")
                                        {
                                            <button type="button" class="btn btn-sm p-0 border-0" onclick="toggleServiceStatus('@item.id', 'Active')" title="Click to change status">
                                                <span class="badge bg-success">
                                                    Active
                                                </span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm p-0 border-0" onclick="toggleServiceStatus('@item.id', 'Inactive')" title="Click to change status">
                                                <span class="badge bg-warning text-dark">
                                                    Inactive
                                                </span>
                                            </button>
                                        }

                                    </td>
                                    <!-- Actions -->
                                    <td>
                                        <a href="@Url.Action("ServiceMaster", "Admin", new { id = item.id })" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a href="@Url.Action("DeleteService", "Admin", new { id = item.id })" class="btn btn-sm btn-outline-danger" title="Delete"
                                           onclick="return confirm('Are you sure you want to delete this service?');">
                                            <i class="bi bi-trash"></i>
                                        </a>

                                    </td>

                                </tr>

                                sr++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No services found.s
                                    <div class="mt-3">
                                        <a href="@Url.Action("ServiceMaster", "Admin")" class="btn btn-primary btn-sm">
                                            <i class="bi bi-plus-lg"></i>
                                            Add Your First Service
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

    // Delete Service
    function deleteService(id) {

        Swal.fire({
            title: 'Delete Service?',
            text: 'Are you sure you want to delete this service?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Delete',
            cancelButtonText: 'Cancel'
        }).then(function (result) {

            if (result.isConfirmed) {

                window.location.href =
                    '@Url.Action("DeleteService", "Admin")' +
                    '?id=' + id;

            }
        });
    }
    // Toggle Service Status
    function toggleServiceStatus(id, currentStatus) {

        var newStatus = currentStatus === "Active"
            ? "Inactive"
            : "Active";

        Swal.fire({
            title: 'Change Status?',
            text: 'Are you sure you want to change status from ' +
                  currentStatus + ' to ' + newStatus + '?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Yes, Change',
            cancelButtonText: 'Cancel'
        }).then(function (result) {

            if (result.isConfirmed) {

                var form = document.createElement("form");

                form.method = "POST";
                form.action = '@Url.Action("ToggleServiceStatus", "Admin")';

                var input = document.createElement("input");

                input.type = "hidden";
                input.name = "id";
                input.value = id;

                form.appendChild(input);

                document.body.appendChild(form);

                form.submit();
            }
        });
    }
</script>

