@model IEnumerable<Portfolio.Models.experienceMaster>
@{
    ViewBag.Title = "ShowExperience";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
        <i class="bi bi-check-circle me-2"></i> @TempData["Message"]
        <button type="button" class="btn-close" onclick="document.getElementById('successAlert').remove();" aria-label="Close"></button>
    </div>
}

<!-- Error Message -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
        <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" onclick="document.getElementById('errorAlert').remove();" aria-label="Close"></button>
    </div>
}
<div class="container-fluid px-3">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">Experience</h4>
            <small class="text-muted">
                Manage your professional experience details
            </small>
        </div>

        <a href="@Url.Action("ManageExperience", "Admin")"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Experience
        </a>
    </div>


    <!-- Experience List -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th width="70">#</th>
                                <th>Job Title</th>
                                <th>Company</th>
                                <th>Location</th>
                                <th>Employment Type</th>
                                <th>Duration</th>
                                <th>Technologies</th>
                                <th width="100">Order</th>
                                <th width="100">Status</th>
                                <th width="130">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                int serialNo = 1;
                            }

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- Serial Number -->
                                    <td>
                                        @serialNo
                                    </td>


                                    <!-- Job Title -->
                                    <td>
                                        <strong>
                                            @item.JobTitle
                                        </strong>

                                        @if (item.IsCurrent)
                                        {
                                            <div class="mt-1">
                                                <span class="badge bg-success">
                                                    Current
                                                </span>
                                            </div>
                                        }
                                    </td>


                                    <!-- Company -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.CompanyUrl))
                                        {
                                            <a href="@item.CompanyUrl" target="_blank" class="text-decoration-none">
                                                @item.CompanyName
                                                <i class="bi bi-box-arrow-up-right ms-1"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            @item.CompanyName
                                        }
                                    </td>


                                    <!-- Location -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Location))
                                        {
                                            <span>
                                                <i class="bi bi-geo-alt me-1 text-muted"></i>
                                                @item.Location
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>


                                    <!-- Employment Type -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.employmentType))
                                        {
                                            <span class="badge bg-light text-dark border">
                                                @item.employmentType
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <!-- Duration -->
                                    <td>
                                        <div>
                                            @if (!string.IsNullOrEmpty(item.StartDate))
                                            {
                                                @DateTime.Parse(item.StartDate).ToString("MMM yyyy")
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }

                                            <span class="mx-1">-</span>

                                            @if (item.IsCurrent)
                                            {
                                                <span class="text-success fw-semibold">
                                                    Present
                                                </span>
                                            }
                                            else if (!string.IsNullOrEmpty(item.EndDate))
                                            {
                                                @DateTime.Parse(item.EndDate).ToString("MMM yyyy")
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </div>
                                    </td>

                                    <!-- Technologies -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Technologies))
                                        {
                                            <span>
                                                @item.Technologies
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>


                                    <!-- Display Order -->
                                    <td>
                                        <span class="badge bg-secondary">
                                            @item.DisplayOrder
                                        </span>
                                    </td>

                                    <!-- Status -->
                                    <td>

                                        @if (item.Status == "1")
                                        {
                                            <button type="button" class="btn btn-sm p-0 border-0" onclick="toggleExperienceStatus('@item.id', 'Active')" title="Click to change status">
                                                <span class="badge bg-success">
                                                    Active
                                                </span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm p-0 border-0" onclick="toggleExperienceStatus('@item.id', 'Inactive')" title="Click to change status">
                                                <span class="badge bg-warning text-dark">
                                                    Inactive
                                                </span>
                                            </button>
                                        }

                                    </td>
                                    <!-- Actions -->
                                    <td>

                                        <div class="d-flex gap-1">

                                            <!-- Edit -->
                                            <a href="@Url.Action("ManageExperience", "Admin", new { id = item.id })" class="btn btn-sm btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <!----Delete---->
                                            <button type="button" class="btn btn-sm btn-outline-danger" title="Delete" onclick="deleteExperience(@item.id)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>

                                    </td>

                                </tr>

                                serialNo++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="text-center py-5">

                    <div class="mb-3">
                        <i class="bi bi-briefcase" style="font-size: 48px;"></i>
                    </div>

                    <h5>No Experience Added</h5>

                    <p class="text-muted mb-3">
                        You have not added any professional experience yet.
                    </p>

                    <a href="@Url.Action("ManageExperience", "Admin")" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i>
                        Add Your First Experience
                    </a>
                </div>
            }

        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

    // Delete Experience
    function deleteExperience(id) {

        Swal.fire({
            title: 'Delete Experience?',
            text: 'Are you sure you want to delete this experience?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Delete',
            cancelButtonText: 'Cancel'
        }).then(function (result) {

            if (result.isConfirmed) {

                window.location.href =
                    '@Url.Action("DeleteExperience", "Admin")' +
                    '?id=' + id;

            }

        });
    }
    // Toggle Experience Status
    function toggleExperienceStatus(id, currentStatus) {

        var newStatus = currentStatus === "Active"
            ? "Inactive"
            : "Active";
    
        Swal.fire({
            title: 'Change Status?',
            text: 'Are you sure you want to change status from ' +
                  currentStatus + ' to ' + newStatus + '?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Yes, Change',
            cancelButtonText: 'Cancel'
        }).then(function (result) {

            if (result.isConfirmed) {

                var form = document.createElement("form");

                form.method = "POST";
                form.action = '@Url.Action("ToggleExperienceStatus", "Admin")';

                var input = document.createElement("input");

                input.type = "hidden";
                input.name = "id";
                input.value = id;

                form.appendChild(input);

                document.body.appendChild(form);

                form.submit();
            }

        });
    }

</script>