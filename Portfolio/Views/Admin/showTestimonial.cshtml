@model IEnumerable<Portfolio.Models.testimonialMaster>
@{
    ViewBag.Title = "showTestimonial";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="container-fluid px-3">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Testimonials</h3>
            <p class="text-muted mb-0">
                Manage client testimonials for your portfolio.
            </p>
        </div>

        <a href="@Url.Action("TestimonialMaster", "Admin")" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Add Testimonial
        </a>
    </div>
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
            <i class="bi bi-check-circle me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" onclick="document.getElementById('successAlert').remove();" aria-label="Close"></button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
            <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" onclick="document.getElementById('errorAlert').remove();" aria-label="Close"></button>
        </div>
    }
    <!-- Testimonials Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Client</th>
                            <th>Designation</th>
                            <th>Company</th>
                            <th>Message</th>
                            <th>Rating</th>
                            <th>Order</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int srNo = 1;

                            foreach (var item in Model)
                            {
                                <tr>

                                    <!-- Sr No -->
                                    <td>
                                        @srNo
                                    </td>

                                    <!-- Client -->
                                    <td>
                                        <div class="d-flex align-items-center">

                                            @if (!string.IsNullOrEmpty(item.clientImage))
                                            {
                                                <img src="@Url.Content(item.clientImage)" alt="@item.clientName" style="width:45px; height:45px; object-fit:cover; border-radius:50%; margin-right:10px;" />
                                            }
                                            else
                                            {
                                                <div class="bg-light border rounded-circle d-flex align-items-center justify-content-center me-2" style="width:45px;height:45px;">
                                                    <i class="bi bi-person text-muted"></i>
                                                </div>
                                            }
                                            <strong>
                                                @item.clientName
                                            </strong>
                                        </div>
                                    </td>

                                    <!-- Designation -->
                                    <td>
                                        @(string.IsNullOrEmpty(item.designation)
                                        ? "-"
                                        : item.designation)
                                    </td>

                                    <!-- Company -->
                                    <td>
                                        @(string.IsNullOrEmpty(item.companyName)
                                        ? "-"
                                        : item.companyName)
                                    </td>

                                    <!-- Message -->
                                    <td style="max-width:300px;">
                                        @if (!string.IsNullOrEmpty(item.message))
                                        {
                                            if (item.message.Length > 80)
                                            {
                                                @item.message.Substring(0, 80)<text>...</text>
                                            }
                                            else
                                            {
                                                @item.message
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <!-- Rating -->
                                    <td>
                                        @if (item.rating > 0)
                                        {
                                            for (int i = 1; i <= item.rating; i++)
                                            {
                                                <i class="bi bi-star-fill text-warning"></i>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <!-- Display Order -->
                                    <td>
                                        @item.displayOrder
                                    </td>

                                    <!-- Status -->
                                    <td>

                                        @if (item.status == "1")
                                        {
                                            <button type="button" class="btn btn-sm p-0 border-0" onclick="toggleTestimonialStatus('@item.id', 'Active')" title="Click to change status">
                                                <span class="badge bg-success">
                                                    Active
                                                </span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm p-0 border-0" onclick="toggleTestimonialStatus('@item.id', 'Inactive')" title="Click to change status">
                                                <span class="badge bg-warning text-dark">
                                                    Inactive
                                                </span>
                                            </button>
                                        }

                                    </td>
                                    <!-- Action -->
                                    <td class="text-center">

                                        <!-- Edit -->
                                        <a href="@Url.Action("TestimonialMaster", "Admin", new { id = item.id })" class="btn btn-sm btn-outline-primary me-1" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <!----Delete---->
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Delete" onclick="deleteTestimonial(@item.id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                                srNo++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="bi bi-chat-quote fs-2 d-block mb-2"></i>
                                        No testimonials found.
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

    // Delete Testimonial
    function deleteTestimonial(id) {

        Swal.fire({
            title: 'Delete Testimonial.?',
            text: 'Are you sure you want to delete this record?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Delete',
            cancelButtonText: 'Cancel'
        }).then(function (result) {

            if (result.isConfirmed) {

                window.location.href =
                    '@Url.Action("DeleteTestimonial", "Admin")' +
                    '?id=' + id;

            }

        });
    }
    // Toggle Testimonial Status
    function toggleTestimonialStatus(id, currentStatus) {

        var newStatus = currentStatus === "Active"
            ? "Inactive"
            : "Active";

        Swal.fire({
            title: 'Change Status?',
            text: 'Are you sure you want to change status from ' +
                  currentStatus + ' to ' + newStatus + '?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Yes, Change',
            cancelButtonText: 'Cancel'
        }).then(function (result) {

            if (result.isConfirmed) {

                var form = document.createElement("form");

                form.method = "POST";
                form.action = '@Url.Action("ToggleTestimonialStatus", "Admin")';

                var input = document.createElement("input");

                input.type = "hidden";
                input.name = "id";
                input.value = id;

                form.appendChild(input);

                document.body.appendChild(form);

                form.submit();
            }
        });
    }
</script>



