@model IEnumerable<Portfolio.Models.settingMaster>
@{
    ViewBag.Title = "ShowSettings";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="container-fluid px-3">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Website Settings</h3>
            <p class="text-muted mb-0">
                Manage your portfolio website settings
            </p>
        </div>

        <a href="@Url.Action("SettingMaster", "Admin")" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add Settings
        </a>
    </div>
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
            <i class="bi bi-check-circle me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" onclick="document.getElementById('successAlert').remove();" aria-label="Close"></button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
            <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" onclick="document.getElementById('errorAlert').remove();" aria-label="Close"></button>
        </div>
    }
    <!-- Settings Table -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0">
                <i class="bi bi-gear me-2"></i>
                Website Settings
            </h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Logo</th>
                            <th>Site Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Address</th>
                            <th>Favicon</th>
                            <th>Resume</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int srNo = 1;

                            foreach (var item in Model)
                            {
                                <tr>

                                    <!-- Sr No -->
                                    <td>
                                        @srNo
                                    </td>

                                    <!-- Logo -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.logo))
                                        {
                                            <img src="@Url.Content(item.logo)" alt="Logo" class="img-thumbnail" style="width:70px;height:50px;object-fit:contain;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No Logo
                                            </span>
                                        }
                                    </td>

                                    <!-- Site Name -->
                                    <td>
                                        <strong>
                                            @item.siteName
                                        </strong>
                                    </td>

                                    <!-- Email -->
                                    <td>
                                        @item.email
                                    </td>

                                    <!-- Phone -->
                                    <td>
                                        @item.phone
                                    </td>

                                    <!-- Address -->
                                    <td>
                                        @item.address
                                    </td>

                                    <!-- Favicon -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.favicon))
                                        {
                                            <img src="@Url.Content(item.favicon)" alt="Favicon" class="img-thumbnail" style="width:40px;height:40px;object-fit:contain;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No Favicon
                                            </span>
                                        }
                                    </td>

                                    <!-- Resume -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.resume))
                                        {
                                            <a href="@Url.Content(item.resume)" target="_blank" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-file-earmark-text me-1"></i>
                                                View
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No Resume
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.status == "1")
                                        {
                                            <button type="button" class="btn btn-sm p-0 border-0" onclick="toggleSettingStatus('@item.id', 'Active')" title="Click to change status">
                                                <span class="badge bg-success">
                                                    Active
                                                </span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm p-0 border-0" onclick="toggleSettingStatus('@item.id', 'Inactive')" title="Click to change status">
                                                <span class="badge bg-warning text-dark">
                                                    Inactive
                                                </span>
                                            </button>
                                        }

                                    </td>
                                    <!-- Action -->
                                    <td class="text-center">

                                        <a href="@Url.Action("SettingMaster", "Admin", new { id = item.id })" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <!----Delete---->
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Delete" onclick="deleteSettings(@item.id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                                srNo++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5">

                                    <div class="text-muted">
                                        <i class="bi bi-gear fs-1 d-block mb-2"></i>

                                        <h6>No Settings Found</h6>

                                        <p class="mb-3">
                                            Website settings have not been added yet.
                                        </p>

                                        <a href="@Url.Action("SettingMaster", "Admin")" class="btn btn-primary btn-sm">
                                            <i class="bi bi-plus-circle me-1"></i>
                                            Add Settings
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

    // Delete Settings
    function deleteSettings(id) {

        Swal.fire({
            title: 'Delete Setting.?',
            text: 'Are you sure you want to delete this record?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Delete',
            cancelButtonText: 'Cancel'
        }).then(function (result) {

            if (result.isConfirmed) {

                window.location.href =
                    '@Url.Action("DeleteSettings", "Admin")' +
                    '?id=' + id;

            }

        });
    }
    // Toggle Testimonial Status
    function toggleSettingStatus(id, currentStatus) {

        var newStatus = currentStatus === "Active"
            ? "Inactive"
            : "Active";

        Swal.fire({
            title: 'Change Status?',
            text: 'Are you sure you want to change status from ' +
                  currentStatus + ' to ' + newStatus + '?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Yes, Change',
            cancelButtonText: 'Cancel'
        }).then(function (result) {

            if (result.isConfirmed) {

                var form = document.createElement("form");

                form.method = "POST";
                form.action = '@Url.Action("ToggleSettingStatus", "Admin")';

                var input = document.createElement("input");

                input.type = "hidden";
                input.name = "id";
                input.value = id;

                form.appendChild(input);

                document.body.appendChild(form);

                form.submit();
            }
        });
    }
</script>




