@model IEnumerable<Portfolio.Models.aboutMaster>
@{
    ViewBag.Title = "Show About";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="container-fluid px-3"
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">About Me</h4>
            <p class="text-muted mb-0">
                Manage your portfolio About section
            </p>
        </div>

        <a href="@Url.Action("AboutMaster", "Admin")" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add About
        </a>
    </div>

    <!-- Success Message -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
            <i class="bi bi-check-circle me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" onclick="document.getElementById('successAlert').remove();" aria-label="Close"></button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
            <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" onclick="document.getElementById('errorAlert').remove();" aria-label="Close"></button>
        </div>
    }

    <!-- About Table -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Image</th>
                            <th>Heading</th>
                            <th>Designation</th>
                            <th>Experience</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int srNo = 1;

                            foreach (var item in Model)
                            {
                                <tr>
                                    <!-- Sr No -->
                                    <td>
                                        @srNo
                                    </td>
                                    <!-- Profile Image -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.profileImage))
                                        {
                                            <img src="@Url.Content(item.profileImage)" alt="Profile Image" style="width:60px; height:60px; object-fit:cover; border-radius:8px;" class="border" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No Image
                                            </span>
                                        }
                                    </td>

                                    <!-- Heading -->
                                    <td>
                                        <strong>
                                            @item.heading
                                        </strong>
                                    </td>

                                    <!-- Designation -->
                                    <td>
                                        @item.designation
                                    </td>

                                    <!-- Experience -->
                                    <td>
                                        @item.experience
                                    </td>

                                    <!-- Description -->
                                    <td style="max-width:300px;">
                                        @{
                                            string description = item.description ?? "";

                                            if (description.Length > 100)
                                            {
                                                description = description.Substring(0, 100)
                                                    + "...";
                                            }
                                        }

                                        @description
                                    </td>
                                    <!-- Status -->
                                    <td>

                                        @if (item.status == "1")
                                        {
                                            <button type="button" class="btn btn-sm p-0 border-0" onclick="toggleAboutStatus('@item.id', 'Active')" title="Click to change status">
                                                <span class="badge bg-success">
                                                    Active
                                                </span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm p-0 border-0" onclick="toggleAboutStatus('@item.id', 'Inactive')" title="Click to change status">
                                                <span class="badge bg-warning text-dark">
                                                    Inactive
                                                </span>
                                            </button>
                                        }

                                    </td>
                                    <!-- Action -->
                                    <td>
                                        <div class="d-flex gap-2">
                                            <!-- Edit -->
                                            <a href="@Url.Action( "AboutMaster", "Admin", new { id = item.id })" class="btn btn-sm btn-outline-primary"
                                               title="Edit">

                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <!----Delete---->
                                            <button type="button" class="btn btn-sm btn-outline-danger" title="Delete" onclick="deleteAbout(@item.id)">
                                                <i class="bi bi-trash"></i>
                                            </button>

                                        </div>
                                    </td>

                                </tr>

                                srNo++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8"
                                    class="text-center text-muted py-4">

                                    <i class="bi bi-info-circle me-1"></i>
                                    No About Details Found.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>


<!-- SweetAlert -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

    // Delete About
    function deleteAbout(id) {

        Swal.fire({
            title: 'Delete About?',
            text: 'Are you sure you want to delete this about information?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Delete',
            cancelButtonText: 'Cancel'
        }).then(function (result) {

            if (result.isConfirmed) {

                window.location.href =
                    '@Url.Action("DeleteAbout", "Admin")' +
                    '?id=' + id;

            }

        });
    }
    // Toggle About Status
    function toggleAboutStatus(id, currentStatus) {

        var newStatus = currentStatus === "Active"
            ? "Inactive"
            : "Active";

        Swal.fire({
            title: 'Change Status?',
            text: 'Are you sure you want to change status from ' +
                  currentStatus + ' to ' + newStatus + '?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Yes, Change',
            cancelButtonText: 'Cancel'
        }).then(function (result) {

            if (result.isConfirmed) {

                var form = document.createElement("form");

                form.method = "POST";
                form.action = '@Url.Action("ToggleAboutStatus", "Admin")';

                var input = document.createElement("input");

                input.type = "hidden";
                input.name = "id";
                input.value = id;

                form.appendChild(input);

                document.body.appendChild(form);

                form.submit();
            }

        });
    }

</script>